{
  "name": "paper-conference-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official conference deadlines and dates, refreshed hourly",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "open": "node scripts/launch.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "sync": "node scripts/sync.mjs",
    "build:static": "node scripts/build-static.mjs"
  }
}
